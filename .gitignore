# Firebase service account keys — NEVER COMMIT THESE
# Covers both hand-named and Google-generated names, e.g.
#   centralized-system-d378f-195dde361f73.json
#   <project>-<project>-<16-hex>.json
serviceAccountKey.json
service-account*.json
centralized-system-*.json
*-firebase-adminsdk-*.json
*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].json
scripts/*Key*.json
scripts/*key*.json

